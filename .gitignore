# Secrets (keep .env.example tracked)
.env
.env.*
!.env.example

# Local databases / audit logs
*.db
*.sqlite3

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Tooling state
.claude/
.claude-flow/
.swarm/
.agents/
.codex/

# OS / editor
.DS_Store
.idea/
.vscode/

# Python build / test / lint artifacts
*.egg-info/
build/
dist/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Logs and temp
*.log
*.tmp
*.bak
*.swp

# Office lock/temp files
~$*
.~lock.*#

# Node (if the frontend adds tooling)
node_modules/

# Benchmark run outputs (cases.jsonl stays tracked)
benchmark/results/
benchmark/*_results.*

# Local planning notes
LLM_addition.md

# Local-model training: generated data, checkpoints and adapters (regenerate with training/make_intake_dataset.py)
training/data/
training/outputs/

# Downloaded adapter archives and per-case benchmark outputs
*.zip
benchmark/intake_compare_*.json

# LaTeX build artifacts for docs/report (sources and main.pdf stay tracked)
docs/report/*.aux
docs/report/*.bbl
docs/report/*.blg
docs/report/*.fdb_latexmk
docs/report/*.fls
docs/report/*.lof
docs/report/*.lot
docs/report/*.out
docs/report/*.toc
docs/report/*.synctex.gz
